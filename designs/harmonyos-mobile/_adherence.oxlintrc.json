{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/containers/**",
              "components/controls/**",
              "components/shell/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIBottomBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|indicator|className|key|ref|style|children)$/]",
        "message": "<AIBottomBar> doesn't accept that prop. Declared props: theme, indicator, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIBottomBar'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AIBottomBar> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|items|activeIndex|onSelect|homeIndicatorBar|albumSrc|expandLabel|expandIcons|label|onClick|circleIcon|className|key|ref|style|children)$/]",
        "message": "<BottomTab> doesn't accept that prop. Declared props: variant, items, activeIndex, onSelect, homeIndicatorBar, albumSrc, expandLabel, expandIcons, label, onClick, circleIcon, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomTab'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:2|3|4|5|1bar|multibar)$/]",
        "message": "<BottomTab> variant must be one of '2' | '3' | '4' | '5' | '1bar' | 'multibar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|type|loading|disabled|icon|onClick|className|style|light|key|ref)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, size, type, loading, disabled, icon, onClick, className, style, light."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium)$/]",
        "message": "<Button> size must be one of 'small' | 'medium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:emphasized|normal|selected|unselected|warning)$/]",
        "message": "<Button> type must be one of 'emphasized' | 'normal' | 'selected' | 'unselected' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardView'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|iconButtons|onClick|className|style|children|key|ref)$/]",
        "message": "<CardView> doesn't accept that prop. Declared props: size, iconButtons, onClick, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardView'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:mini|small|medium|larger|max)$/]",
        "message": "<CardView> size must be one of 'mini' | 'small' | 'medium' | 'larger' | 'max'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|className|key|ref|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:|inset|block|vertical)$/]",
        "message": "<Divider> variant must be one of '' | 'inset' | 'block' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingChipsTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|chips|activeIndex|onSelect|trailingIcon|onTrailing|className|key|ref|style|children)$/]",
        "message": "<FloatingChipsTab> doesn't accept that prop. Declared props: variant, chips, activeIndex, onSelect, trailingIcon, onTrailing, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingChipsTab'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tab|tab-with-icon|icontab)$/]",
        "message": "<FloatingChipsTab> variant must be one of 'tab' | 'tab-with-icon' | 'icontab'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingSearch'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|value|placeholder|on|actionLabel|voice|cancel|onAction|onActivate|onChange|className|light|key|ref|style|children)$/]",
        "message": "<FloatingSearch> doesn't accept that prop. Declared props: mode, value, placeholder, on, actionLabel, voice, cancel, onAction, onActivate, onChange, className, light."
      },
      {
        "selector": "JSXOpeningElement[name.name='FloatingSearch'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:idle|actived|typing|output)$/]",
        "message": "<FloatingSearch> mode must be one of 'idle' | 'actived' | 'typing' | 'output'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|style|label|key|ref|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, style, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='List'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|aux|aux2|appIconSrc|appIconAlt|rightText|rightIcon|onClick|className|children|key|ref|style)$/]",
        "message": "<List> doesn't accept that prop. Declared props: variant, title, aux, aux2, appIconSrc, appIconAlt, rightText, rightIcon, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='List'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:single|icondot|iconsingle|2lines|icon2lines|3lines)$/]",
        "message": "<List> variant must be one of 'single' | 'icondot' | 'iconsingle' | '2lines' | 'icon2lines' | '3lines'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:device|width|height|theme|materialType|materialLevel|statusbar|titlebar|bottomBar|homeIndicator|lightEffect|className|style|children|key|ref)$/]",
        "message": "<SizeFrame> doesn't accept that prop. Declared props: device, width, height, theme, materialType, materialLevel, statusbar, titlebar, bottomBar, homeIndicator, lightEffect, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeFrame'] > JSXAttribute[name.name='device'] > Literal[value!=/^(?:phone-portrait|phone-landscape|foldable|tablet-portrait|tablet-landscape)$/]",
        "message": "<SizeFrame> device must be one of 'phone-portrait' | 'phone-landscape' | 'foldable' | 'tablet-portrait' | 'tablet-landscape'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeFrame'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SizeFrame> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeFrame'] > JSXAttribute[name.name='materialType'] > Literal[value!=/^(?:adaptive|immersive)$/]",
        "message": "<SizeFrame> materialType must be one of 'adaptive' | 'immersive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SizeFrame'] > JSXAttribute[name.name='materialLevel'] > Literal[value!=/^(?:exquisite|gentle|smooth)$/]",
        "message": "<SizeFrame> materialLevel must be one of 'exquisite' | 'gentle' | 'smooth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|theme|className|key|ref|style|children)$/]",
        "message": "<StatusBar> doesn't accept that prop. Declared props: time, theme, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBar'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<StatusBar> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|disabled|label|onChange|className|light|key|ref|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: on, disabled, label, onChange, className, light."
      },
      {
        "selector": "JSXOpeningElement[name.name='Titlebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|subtitle|time|leadingGlyph|onLeading|actions|showStatus|theme|className|children|key|ref|style)$/]",
        "message": "<Titlebar> doesn't accept that prop. Declared props: variant, title, subtitle, time, leadingGlyph, onLeading, actions, showStatus, theme, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Titlebar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:big|normal|secondary|drawer)$/]",
        "message": "<Titlebar> variant must be one of 'big' | 'normal' | 'secondary' | 'drawer'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Titlebar'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Titlebar> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|items|activeIndex|onSelect|className|key|ref|style|children)$/]",
        "message": "<Toolbar> doesn't accept that prop. Declared props: variant, items, activeIndex, onSelect, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toolbar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:3|4|5|6|vertical-icon)$/]",
        "message": "<Toolbar> variant must be one of '3' | '4' | '5' | '6' | 'vertical-icon'."
      }
    ]
  },
