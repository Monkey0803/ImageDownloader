import { image } from '@kit.ImageKit';
import { util } from '@kit.ArkTS';
import { fileIo as fs, hash } from '@kit.CoreFileKit';
import { abilityDelegatorRegistry } from '@kit.TestKit';
import { describe, it, expect } from '@ohos/hypium';
import { EditDocument, EditHistory, EditPoint, EditRect, EditStroke } from '../../../main/ets/model/ImageEditDocument';
import { DownloadItem } from '../../../main/ets/model/Models';
import { AnalysisToken, AssetStamp } from '../../../main/ets/model/LibraryAsset';
import { LibraryImageReader } from '../../../main/ets/service/LibraryImageReader';
import { EditExport } from '../../../main/ets/service/EditExport';
import { ImageEditGeometry } from '../../../main/ets/util/ImageEditGeometry';

function point(x: number, y: number): EditPoint {
  const value: EditPoint = new EditPoint(); value.x = x; value.y = y; return value;
}

function rect(x: number, y: number, width: number, height: number): EditRect {
  const value: EditRect = new EditRect();
  value.x = x; value.y = y; value.width = width; value.height = height; return value;
}

function equalPoint(actual: EditPoint | undefined, x: number, y: number): void {
  expect(actual !== undefined).assertTrue();
  if (actual !== undefined) {
    expect(Math.abs(actual.x - x) < 0.0000001).assertTrue();
    expect(Math.abs(actual.y - y) < 0.0000001).assertTrue();
  }
}

function equalRect(actual: EditRect, x: number, y: number, width: number, height: number): void {
  expect(actual.x).assertEqual(x); expect(actual.y).assertEqual(y);
  expect(actual.width).assertEqual(width); expect(actual.height).assertEqual(height);
}


function writeFixture(path: string, encoded: string): void {
  const bytes: Uint8Array = new util.Base64Helper().decodeSync(encoded);
  const file: fs.File = fs.openSync(path, fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
  try { fs.writeSync(file.fd, bytes.buffer); } finally { fs.closeSync(file); }
}

async function outputPixels(path: string): Promise<Uint8Array> {
  const source: image.ImageSource = image.createImageSource(path);
  let frame: image.PixelMap | undefined;
  try {
    frame = await source.createPixelMap({ desiredPixelFormat: image.PixelMapFormat.RGBA_8888 });
    return await LibraryImageReader.rgba(frame);
  } finally {
    try { if (frame !== undefined) { await frame.release(); } } finally { await source.release(); }
  }
}

function equalPixel(bytes: Uint8Array, width: number, x: number, y: number, rgba: number[]): void {
  const offset: number = (y * width + x) * 4;
  for (let channel: number = 0; channel < 4; channel++) {
    expect(bytes[offset + channel]).assertEqual(rgba[channel]);
  }
}

export default function imageEditTest() {
  describe('ImageEditGeometryNative', () => {
    it('maps_every_cropped_pixel_against_independent_rotated_label_grids', 0, () => {
      // Source is a labelled 8x6 raster: pixel label = y*8+x. Crop (2,1,4,3).
      // These explicit output grids are independent of production transform formulas.
      const oracles: number[][][] = [
        [[10,11,12,13],[18,19,20,21],[26,27,28,29]],
        [[26,18,10],[27,19,11],[28,20,12],[29,21,13]],
        [[29,28,27,26],[21,20,19,18],[13,12,11,10]],
        [[13,21,29],[12,20,28],[11,19,27],[10,18,26]]
      ];
      const doc: EditDocument = ImageEditGeometry.create(8, 6);
      doc.crop = rect(2, 1, 4, 3);
      for (let turns: number = 0; turns < 4; turns++) {
        doc.turns = turns;
        expect(ImageEditGeometry.outputSize(doc).height).assertEqual(oracles[turns].length);
        expect(ImageEditGeometry.outputSize(doc).width).assertEqual(oracles[turns][0].length);
        for (let y: number = 0; y < oracles[turns].length; y++) {
          for (let x: number = 0; x < oracles[turns][y].length; x++) {
            const label: number = oracles[turns][y][x];
            const sourceX: number = label % 8;
            const sourceY: number = Math.floor(label / 8);
            equalPoint(ImageEditGeometry.toSource(point(x, y), doc), sourceX, sourceY);
            equalPoint(ImageEditGeometry.toOutput(point(sourceX, sourceY), doc), x, y);
          }
        }
      }
      doc.turns = -1;
      equalPoint(ImageEditGeometry.toOutput(point(5, 1), doc), 0, 0);
    });

    it('clamps_negative_drags_and_fractional_bounds_to_source_pixels', 0, () => {
      equalRect(ImageEditGeometry.constrainCrop(rect(8, 6, -12, -9), 10, 8), 0, 0, 8, 6);
      equalRect(ImageEditGeometry.constrainCrop(rect(-5, -3, -4, -2), 10, 8), 0, 0, 1, 1);
      equalRect(ImageEditGeometry.constrainCrop(rect(14, 12, -1, -2), 10, 8), 9, 7, 1, 1);
      equalRect(ImageEditGeometry.constrainCrop(rect(5.8, 4.2, -3.1, -2.8), 10, 8), 2, 1, 4, 4);
      equalRect(ImageEditGeometry.constrainCrop(rect(1, 1, Number.NaN, 2), 10, 8), 0, 0, 10, 8);
    });

    it('centers_aspect_crops_inside_the_existing_source_crop', 0, () => {
      const doc: EditDocument = ImageEditGeometry.create(400, 300);
      doc.crop = rect(40, 30, 320, 240);
      equalRect(ImageEditGeometry.aspectCrop(doc, 1), 80, 30, 240, 240);
      equalRect(ImageEditGeometry.aspectCrop(doc, 16 / 9), 40, 60, 320, 180);
      equalRect(ImageEditGeometry.aspectCrop(doc, 0), 40, 30, 320, 240);
      equalRect(doc.crop, 40, 30, 320, 240);
    });

    it('keeps_undo_and_copy_nested_strokes_independent_of_later_mutations', 0, () => {
      const doc: EditDocument = ImageEditGeometry.create(100, 80);
      const stroke: EditStroke = new EditStroke();
      stroke.kind = 'pen'; stroke.color = '#123456'; stroke.width = 3;
      stroke.points = [point(10, 20), point(30, 40)]; doc.strokes = [stroke];
      const history: EditHistory = new EditHistory(); history.reset(doc);
      expect(history.canUndo()).assertFalse();
      doc.crop.x = 5; doc.turns = 1; doc.strokes[0].points[0].x = 50;
      history.commit(doc);
      doc.crop.x = 9; doc.strokes[0].color = '#FFFFFF'; doc.strokes[0].points[0].x = 90;
      history.commit(doc);
      doc.crop.x = 11; doc.strokes[0].color = '#000000'; doc.strokes[0].points[0].x = 99;
      const committed: EditDocument | undefined = history.undo();
      expect(committed !== undefined).assertTrue();
      if (committed !== undefined) {
        expect(committed.crop.x).assertEqual(5); expect(committed.turns).assertEqual(1);
        expect(committed.strokes[0].color).assertEqual('#123456');
        equalPoint(committed.strokes[0].points[0], 50, 20);
      }
      const undone: EditDocument | undefined = history.undo();
      expect(undone !== undefined).assertTrue();
      if (undone === undefined) { return; }
      equalRect(undone.crop, 0, 0, 100, 80);
      expect(undone.turns).assertEqual(0); expect(undone.strokes[0].color).assertEqual('#123456');
      equalPoint(undone.strokes[0].points[0], 10, 20);
      undone.crop.y = 7; undone.strokes[0].points[0].y = 77;
      history.commit(doc);
      const again: EditDocument | undefined = history.undo();
      expect(again !== undefined).assertTrue();
      if (again !== undefined) {
        expect(again.crop.y).assertEqual(0); equalPoint(again.strokes[0].points[0], 10, 20);
      }
      expect(history.canUndo()).assertFalse(); expect(history.undo() === undefined).assertTrue();
      const copy: EditDocument = ImageEditGeometry.copy(doc);
      copy.crop.x = 99; copy.strokes[0].points[1].x = 88; copy.strokes.push(new EditStroke());
      expect(doc.crop.x).assertEqual(11); equalPoint(doc.strokes[0].points[1], 30, 40);
      expect(doc.strokes.length).assertEqual(1);
    });

    it('excludes_letterbox_bars_and_maps_pixel_centers_on_both_viewports', 0, () => {
      const square: EditDocument = ImageEditGeometry.create(400, 400);
      const landscape: EditRect = rect(10, 20, 600, 300);
      equalRect(ImageEditGeometry.viewRect(square, landscape), 160, 20, 300, 300);
      for (const outside of [point(159, 100), point(460, 100), point(200, 19), point(200, 320)]) {
        expect(ImageEditGeometry.viewToSource(outside, square, landscape) === undefined).assertTrue();
      }
      equalPoint(ImageEditGeometry.sourceToView(point(0, 0), square, landscape), 160.375, 20.375);
      equalPoint(ImageEditGeometry.viewToSource(point(160.375, 20.375), square, landscape), 0, 0);
      const wide: EditDocument = ImageEditGeometry.create(400, 200);
      const portrait: EditRect = rect(10, 20, 300, 600);
      equalRect(ImageEditGeometry.viewRect(wide, portrait), 10, 245, 300, 150);
      for (const outside of [point(100, 244), point(100, 395), point(9, 300), point(310, 300)]) {
        expect(ImageEditGeometry.viewToSource(outside, wide, portrait) === undefined).assertTrue();
      }
      equalPoint(ImageEditGeometry.sourceToView(point(399, 199), wide, portrait), 309.625, 394.625);
      equalPoint(ImageEditGeometry.viewToSource(point(309.625, 394.625), wide, portrait), 399, 199);
      const crop: EditDocument = ImageEditGeometry.create(8, 6);
      crop.crop = rect(2, 1, 4, 3); crop.turns = 1;
      const viewport: EditRect = rect(100, 200, 300, 200);
      equalRect(ImageEditGeometry.viewRect(crop, viewport), 175, 200, 150, 200);
      equalPoint(ImageEditGeometry.sourceToView(point(2, 1), crop, viewport), 300, 225);
      equalPoint(ImageEditGeometry.viewToSource(point(300, 225), crop, viewport), 2, 1);
    });
    it('reports_position_area_channel_alpha_and_padded_stride', 0, async () => {
      const helper: util.Base64Helper = new util.Base64Helper();
      const fixture: string = 'iVBORw0KGgoAAAANSUhEUgAAAAMAAAACCAYAAACddGYaAAAAGUlEQVR4nGP4z8DQwMDwv4HhP8N/JgYkAABd6gT/k+ah/AAAAABJRU5ErkJggg==';
      const reports: string[] = [];
      for (const channel of [128, 255]) {
        const source: image.ImageSource = image.createImageSource(helper.decodeSync(fixture).buffer);
        let frame: image.PixelMap | undefined;
        try {
          frame = await source.createPixelMap({ editable: true,
            desiredPixelFormat: image.PixelMapFormat.RGBA_8888 });
          const info: image.ImageInfo = await frame.getImageInfo();
          const original: ArrayBuffer = new ArrayBuffer(frame.getPixelBytesNumber());
          await frame.readPixelsToBuffer(original);
          const readBuffer: Uint8Array = new Uint8Array(36).fill(77);
          await frame.readPixels({ pixels: readBuffer.buffer, offset: 4, stride: 16,
            region: { x: 0, y: 0, size: { width: 3, height: 2 } } });
          const writeBuffer: Uint8Array = new Uint8Array(16).fill(99);
          writeBuffer.set([0, 0, channel, 128], 4);
          await frame.writePixels({ pixels: writeBuffer.buffer, offset: 4, stride: 8,
            region: { x: 1, y: 1, size: { width: 1, height: 1 } } });
          const after: ArrayBuffer = new ArrayBuffer(frame.getPixelBytesNumber());
          await frame.readPixelsToBuffer(after);
          reports.push(JSON.stringify({ inputChannel: channel, info: info,
            rowBytes: frame.getBytesNumberPerRow(), pixelBytes: frame.getPixelBytesNumber(),
            original: Array.from(new Uint8Array(original)), areaRead: Array.from(readBuffer),
            writeBuffer: Array.from(writeBuffer), after: Array.from(new Uint8Array(after)) }));
          expect(Array.from(readBuffer).join(',')).assertEqual([
            77,77,77,77,0,0,255,128,255,0,0,128,0,255,0,255,
            77,77,77,77,0,0,255,128,255,0,0,128,0,255,0,255,77,77,77,77].join(','));
          const afterBytes: Uint8Array = new Uint8Array(after);
          expect(afterBytes[16]).assertEqual(channel === 128 ? 64 : 128);
          expect(afterBytes[17]).assertEqual(0); expect(afterBytes[18]).assertEqual(0);
          expect(afterBytes[19]).assertEqual(128);
          for (let i: number = 0; i < afterBytes.length; i++) {
            if (i < 16 || i >= 20) { expect(afterBytes[i]).assertEqual(new Uint8Array(original)[i]); }
          }
        } finally {
          try { if (frame !== undefined) { await frame.release(); } } finally { await source.release(); }
        }
      }
      const root: string = abilityDelegatorRegistry.getAbilityDelegator().getAppContext().filesDir;
      const file: fs.File = fs.openSync(root + '/library-edit-pixels.jsonl',
        fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
      try { fs.writeSync(file.fd, reports.join('\n')); } finally { fs.closeSync(file); }
      expect(reports.length).assertEqual(2);
    });

    it('exports_real_png_pixels_without_modifying_source_and_cleans_cancelled_pending', 0, async () => {
      const root: string = abilityDelegatorRegistry.getAbilityDelegator().getAppContext().filesDir;
      const folder: string = root + '/library-test-edit-' + Date.now().toString();
      fs.mkdirSync(folder, true);
      const sourcePath: string = folder + '/source.png';
      const pending: string = folder + '/pending.png';
      const rotated: string = folder + '/rotated.png';
      const cancelled: string = folder + '/cancelled.png';
      const largeSource: string = folder + '/large.png';
      const latePending: string = folder + '/late.png';
      const reports: string[] = [];
      try {
        writeFixture(sourcePath, 'iVBORw0KGgoAAAANSUhEUgAAABgAAAAQCAYAAAAMJL+VAAAAN0lEQVR4nO3NsQ0AIAzEQD+bM7kRYgAaUpEbwI4gRSIMCpniwdaDqx5c9eCzwQzk9SCgvu8ewgLxWQid1Hw2KgAAAABJRU5ErkJggg==');
        const before: string = await hash.hash(sourcePath, 'sha256');
        expect(before.toLowerCase()).assertEqual('324631018891434d90bf4b82de2a90f4ec01dc8e014c0d2a3ceff3b116e83a00');
        const item: DownloadItem = new DownloadItem();
        item.id = 'edit-native'; item.path = sourcePath; item.kind = 'image'; item.status = 'completed';
        const stamp: AssetStamp = await LibraryImageReader.stamp(item);
        const doc: EditDocument = ImageEditGeometry.create(24, 16);
        const pen: EditStroke = new EditStroke();
        pen.kind = 'pen'; pen.color = '#0000FF'; pen.width = 1;
        pen.points = [point(4, 3), point(10, 3)];
        const outline: EditStroke = new EditStroke();
        outline.kind = 'rect'; outline.color = '#000000'; outline.width = 1;
        outline.points = [point(6, 6), point(18, 12)]; doc.strokes = [pen, outline];
        const result = await EditExport.render(stamp, doc, pending, new AnalysisToken());
        expect(result.width).assertEqual(24); expect(result.height).assertEqual(16);
        expect(result.bytes > 0).assertTrue(); expect(result.bytes).assertEqual(fs.statSync(pending).size);
        const pixels: Uint8Array = await outputPixels(pending);
        equalPixel(pixels,24,0,0,[255,0,0,255]); equalPixel(pixels,24,23,0,[0,255,0,255]);
        equalPixel(pixels,24,0,15,[0,0,255,255]); equalPixel(pixels,24,23,15,[255,255,0,255]);
        equalPixel(pixels,24,7,3,[0,0,255,255]);
        equalPixel(pixels,24,12,6,[0,0,0,255]); equalPixel(pixels,24,6,9,[0,0,0,255]);
        equalPixel(pixels,24,18,9,[0,0,0,255]); equalPixel(pixels,24,12,12,[0,0,0,255]);
        equalPixel(pixels,24,12,9,[255,0,0,255]);
        equalPixel(pixels,24,2,14,[255,0,0,128]); equalPixel(pixels,24,3,14,[0,0,0,0]);
        reports.push(JSON.stringify({ stage: 'annotated', result: result, pixels: Array.from(pixels),
          sourceSha: before, outputSha: await hash.hash(pending, 'sha256') }));
        const cropped: EditDocument = ImageEditGeometry.create(24, 16);
        cropped.crop = rect(2, 2, 20, 12); cropped.turns = 1;
        const cropPen: EditStroke = new EditStroke();
        cropPen.color = '#0000FF'; cropPen.width = 1; cropPen.points = [point(4, 3), point(10, 3)];
        cropped.strokes = [cropPen];
        const cropResult = await EditExport.render(stamp, cropped, rotated, new AnalysisToken());
        expect(cropResult.width).assertEqual(12); expect(cropResult.height).assertEqual(20);
        const cropPixels: Uint8Array = await outputPixels(rotated);
        equalPixel(cropPixels,12,10,5,[0,0,255,255]); // Source(7,3) -> crop(5,1) -> CW(10,5).
        equalPixel(cropPixels,12,5,10,[255,0,0,255]);
        reports.push(JSON.stringify({ stage: 'crop_rotated', result: cropResult }));
        const stopped: AnalysisToken = new AnalysisToken(); stopped.cancel();
        let preCancelled: boolean = false;
        try { await EditExport.render(stamp, doc, cancelled, stopped); } catch (error) { preCancelled = true; }
        expect(preCancelled).assertTrue(); expect(fs.accessSync(cancelled)).assertFalse();
        const existingSha: string = await hash.hash(pending, 'sha256');
        let rejectedExisting: boolean = false;
        try { await EditExport.render(stamp, doc, pending, new AnalysisToken()); }
        catch (error) { rejectedExisting = true; }
        expect(rejectedExisting).assertTrue(); expect(await hash.hash(pending, 'sha256')).assertEqual(existingSha);
        writeFixture(largeSource, '');
        item.path = largeSource;
        const largeStamp: AssetStamp = await LibraryImageReader.stamp(item);
        let observedOwned: boolean = false;
        let lateCancelled: boolean = false;
        let attempts: number = 0;
        // A fast pack may finish between timer callbacks; retry injection at most three times.
        while (!observedOwned && attempts < 3) {
          attempts++;
          const token: AnalysisToken = new AnalysisToken();
          const timer: number = setInterval(() => {
            if (fs.accessSync(latePending)) { observedOwned = true; token.cancel(); }
          }, 1);
          try { await EditExport.render(largeStamp, ImageEditGeometry.create(2048, 2048), latePending, token); }
          catch (error) {
            if (!observedOwned) { throw new Error(String(error)); }
            lateCancelled = true;
          } finally { clearInterval(timer); }
          if (!observedOwned && fs.accessSync(latePending)) { fs.unlinkSync(latePending); }
        }
        reports.push(JSON.stringify({ stage: 'cancel', preCancelled: preCancelled,
          existingPreserved: rejectedExisting, observedOwned: observedOwned, lateCancelled: lateCancelled,
          attempts: attempts, lateExists: fs.accessSync(latePending) }));
        if (!observedOwned) { throw new Error('取消故障注入未触发：三次均未观察到pending文件'); }
        expect(lateCancelled).assertTrue(); expect(fs.accessSync(latePending)).assertFalse();
        const after: string = await hash.hash(sourcePath, 'sha256');
        expect(after).assertEqual(before); reports.push(JSON.stringify({ stage: 'source_unchanged', sha: after }));
      } finally {
        try {
          const report: fs.File = fs.openSync(root + '/library-edit-export.jsonl',
            fs.OpenMode.CREATE | fs.OpenMode.WRITE_ONLY | fs.OpenMode.TRUNC);
          try { fs.writeSync(report.fd, reports.join('\n')); } finally { fs.closeSync(report); }
        } finally {
          for (const path of [sourcePath, pending, rotated, cancelled, largeSource, latePending]) {
            try { if (fs.accessSync(path)) { fs.unlinkSync(path); } } catch (error) { }
          }
          fs.rmdirSync(folder);
        }
      }
    });

  });
}
